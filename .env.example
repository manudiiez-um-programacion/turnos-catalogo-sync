# Plantilla de variables de entorno del servicio de catalogo y sincronizacion.
#
#   cp .env.example .env     y completar con los valores reales
#
# .env esta en .gitignore y NUNCA se versiona. Los valores de abajo son
# ejemplos ficticios: ninguno es una credencial real.
#
# Los secretos de integracion (JWT tecnico de catedra, REDIS_PASSWORD, URLs
# privadas) no se escriben en el codigo, ni en application.yaml, ni en el
# README, ni en capturas, ni en logs. El JWT tecnico jamas llega a la app KMP.

# --- Aplicacion ---------------------------------------------------------
# Perfil activo: 'local' para desarrollo, 'test' en pruebas.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
# Swagger UI y /v3/api-docs. En el perfil local viene en true; en el resto,
# en false. Poner en false si hace falta apagarlo tambien en local.
SPRINGDOC_ENABLED=true

# --- Base de datos propia -----------------------------------------------
# PostgreSQL (decision D3, ver docs/adr/0001-arquitectura-hexagonal.md).
# El enunciado §3 exige un gestor servidor y prohibe H2, SQLite y cualquier
# base embebida como almacenamiento principal. Base logica y usuario propios
# de este servicio, sin permisos cruzados con el servicio de turnos.
DB_NAME=catalogo
DB_USERNAME=catalogo
DB_PASSWORD=cambiar-en-local

# DB_URL se usa SOLO al correr la app fuera de Docker (./mvnw spring-boot:run),
# apuntando al PostgreSQL publicado por Docker Compose en localhost.
# Dentro de compose el host es el nombre del servicio, no localhost, y la URL
# la arma compose.yaml a partir de DB_NAME: no hace falta tocar esta linea.
DB_URL=jdbc:postgresql://localhost:5432/catalogo

# Puerto con el que Docker Compose publica PostgreSQL en la maquina. Cambiarlo
# si el 5432 ya esta ocupado por otro PostgreSQL local (y ajustar DB_URL).
DB_PORT=5432

# Cuenta de administracion de la instancia de PostgreSQL. La aplicacion NUNCA
# la usa: solo sirve para que el script de init cree el rol del servicio, que
# es un usuario comun sin permisos sobre otras bases. Ver
# docker/postgres/init/01-crear-base-catalogo.sh.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar-en-local

# --- Entorno de la catedra: se llega por ZeroTier ------------------------
# El servidor de la catedra NO esta en internet: se alcanza por una red
# privada ZeroTier. La API, Redis y Kafka corren todos en la misma IP, que
# la red asigna a ese servidor, en puertos distintos.
#
# Antes de que cualquiera de estas variables sirva hay que estar en la red:
# instalar el cliente, unirse con el network_id, enviarle el node ID al
# profesor y esperar que asigne la IP. El network_id y la IP del servidor
# los da el profesor y NO se versionan. Ver el README.
#
# Los valores de abajo son la FORMA que tiene que tener cada variable, con
# marcadores en lugar de datos reales.

# --- API REST de la catedra ---------------------------------------------
# Solo el origen: esquema, IP y puerto, SIN /api al final. Todas las rutas
# de la referencia de integracion ya lo incluyen (POST /api/authenticate,
# GET /api/synchronization/snapshot), asi que agregarlo aca generaria
# /api/api/... y la llamada daria 404.
CATEDRA_API_BASE_URL=http://IP-DEL-SERVIDOR:PUERTO-API

# Credenciales de la cuenta tecnica del proyecto, creadas una unica vez con
# Postman contra POST /api/student/register (§5.1). Son del proyecto, no de
# un usuario final: las dos identidades no se mezclan (§2).
CATEDRA_TECHNICAL_USERNAME=cambiar
CATEDRA_TECHNICAL_PASSWORD=cambiar

# Al arrancar, el servicio se autentica y verifica que provisioningStatus sea
# PROVISIONED; si no lo es, el arranque falla a proposito. Poner en false para
# desarrollar sin tocar la catedra o mientras el alta no este hecha. Docker
# Compose ya la pasa en false: desde el contenedor el servidor es inalcanzable.
CATEDRA_API_VERIFY_ON_STARTUP=true

# --- Redis de la catedra ------------------------------------------------
# El usuario y la contrasena llegan en el objeto "integration" del login
# tecnico (§5.3), no se inventan. El host es el del servidor de ZeroTier.
# REDIS_PASSWORD solo se entrega cuando provisioningStatus == PROVISIONED.
REDIS_HOST=IP-DEL-SERVIDOR
REDIS_PORT=6379
REDIS_USERNAME=grp_mi-grupo
REDIS_PASSWORD=cambiar

# --- Kafka de la catedra ------------------------------------------------
# El topic y el consumer group tambien vienen en "integration" y se leen de
# ahi en tiempo de ejecucion: no se fijan en el codigo. Ojo que el puerto de
# Kafka no es el 9092 habitual.
KAFKA_BOOTSTRAP_SERVERS=IP-DEL-SERVIDOR:PUERTO-KAFKA

# --- Seguridad de la API propia -----------------------------------------
# Decisiones D1, D4 y D5, cerradas en
# docs/adr/0002-identidad-y-autenticacion-entre-servicios.md.
#
# Este servicio NO tiene usuarios ni login: el servicio de turnos es dueño de
# la identidad del usuario final y emite su JWT; aca solo se valida. Y la
# agenda vigente que consume turnos exige un JWT tecnico interno propio del
# proyecto, que no es el JWT tecnico de catedra: ese ultimo solo se usa como
# credencial de SALIDA hacia el servicio central y nunca se acepta como
# credencial de entrada.
#
# Los dos tokens se firman con secretos DISTINTOS a proposito: asi un token de
# usuario no sirve para la API interna ni al reves, y la separacion es
# criptografica en lugar de una comprobacion de claims (§9). Se implementa en
# el issue #17.

# JWT del usuario final, emitido por el servicio de turnos y validado aca.
# HS256 con secreto compartido: el MISMO valor tiene que estar en el .env de
# los dos servicios. Minimo 256 bits (32 caracteres); generar uno con
# `openssl rand -base64 48`. Nunca se versiona.
JWT_USER_SECRET=cambiar-en-local-minimo-32-caracteres
# Emisor esperado en el claim 'iss' de ese token.
JWT_USER_ISSUER=turnos-reservas-service

# JWT tecnico interno con el que el servicio de turnos llama a la agenda
# vigente. Secreto propio, distinto del de arriba, tambien compartido con
# turnos. El token lleva la autoridad SERVICE_TURNOS.
JWT_INTERNAL_SECRET=cambiar-en-local-minimo-32-caracteres
JWT_INTERNAL_ISSUER=turnos-reservas-service

# Origenes permitidos para CORS, separados por coma. Nunca "*" (§9).
CORS_ALLOWED_ORIGINS=http://localhost:8080
