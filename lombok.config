# Marca el codigo que genera Lombok con @lombok.Generated.
#
# Existe por la cobertura. Sin esto, JaCoCo cuenta como lineas sin probar
# todos los getters, setters, builders, equals y constructores que Lombok
# genera, y este proyecto los usa en cada modelo y cada entidad. El numero
# resultante no mediria la calidad de las pruebas sino la cantidad de
# anotaciones de Lombok, y bajaria justamente cuando se agrega un modelo
# bien hecho.
#
# JaCoCo ignora por convencion todo lo anotado con una anotacion llamada
# "Generated", asi que alcanza con pedirle a Lombok que la agregue.
lombok.addLombokGeneratedAnnotation = true

# Este es el archivo raiz de configuracion: Lombok no sigue buscando mas
# arriba en el arbol de directorios.
config.stopBubbling = true
