# Plantilla de variables de entorno del servicio de catalogo y sincronizacion.
#
#   cp .env.example .env     y completar con los valores reales
#
# .env esta en .gitignore y NUNCA se versiona. Los valores de abajo son
# ejemplos ficticios: ninguno es una credencial real.
#
# Los secretos de integracion (JWT tecnico de catedra, REDIS_PASSWORD, URLs
# privadas) no se escriben en el codigo, ni en application.yaml, ni en el
# README, ni en capturas, ni en logs. El JWT tecnico jamas llega a la app KMP.

# --- Base de datos propia -----------------------------------------------
# El motor concreto se define en el issue #3 (decision abierta D3: motor de
# base de datos servidor y herramienta de migraciones). Debe ser un gestor
# servidor: el enunciado §3 prohibe H2, SQLite y cualquier base embebida
# como almacenamiento principal.
DB_URL=jdbc:postgresql://localhost:5432/catalogo
DB_USERNAME=catalogo
DB_PASSWORD=cambiar-en-local

# --- API REST de la catedra ---------------------------------------------
# URL base: la envia la catedra por otro canal (§3). Decision abierta D6.
CATEDRA_API_BASE_URL=https://api.catedra.example/api

# Credenciales de la cuenta tecnica del proyecto, creadas una unica vez con
# Postman contra POST /api/student/register (§5.1). Son del proyecto, no de
# un usuario final: las dos identidades no se mezclan (§2).
CATEDRA_TECHNICAL_USERNAME=cambiar
CATEDRA_TECHNICAL_PASSWORD=cambiar

# --- Redis de la catedra ------------------------------------------------
# Todos estos valores llegan en el objeto "integration" del login tecnico
# (§5.3), no se inventan. Se dejan configurables para arranques en frio y
# para las pruebas.
# REDIS_PASSWORD solo se entrega cuando provisioningStatus == PROVISIONED.
REDIS_HOST=redis.catedra.example
REDIS_PORT=6379
REDIS_USERNAME=grp_mi-grupo
REDIS_PASSWORD=cambiar

# --- Kafka de la catedra ------------------------------------------------
# Tambien vienen en "integration". El topic y el consumer group se leen de
# ahi en tiempo de ejecucion: no se fijan en el codigo.
KAFKA_BOOTSTRAP_SERVERS=kafka.catedra.example:9092

# --- Seguridad de la API propia -----------------------------------------
# Validacion del JWT que este servicio recibe. La forma concreta (secreto
# compartido o JWKS) depende de las decisiones abiertas D1 (donde viven el
# registro y el login de usuarios finales) y D4 (JWT propagado o tecnico
# interno entre los dos servicios). Se define en el issue #17.
JWT_ISSUER_URI=
JWT_SECRET=
JWT_JWKS_URI=

# Origenes permitidos para CORS, separados por coma. Nunca "*" (§9).
CORS_ALLOWED_ORIGINS=http://localhost:8080
