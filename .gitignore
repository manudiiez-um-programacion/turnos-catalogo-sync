# --- Secretos -----------------------------------------------------------
# Nunca se versiona .env: solo .env.example con valores de ejemplo.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# --- Build Maven --------------------------------------------------------
target/
dependency-reduced-pom.xml
.mvn/timing.properties
# El wrapper SI se versiona (mvnw, mvnw.cmd y maven-wrapper.properties):
# es lo que permite clonar y correr ./mvnw verify sin instalar Maven.
# Solo se ignora el jar, que con distributionType=only-script ni existe.
.mvn/wrapper/maven-wrapper.jar

# --- IDE ----------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/settings.json
.settings/
.project
.classpath
.factorypath
nbproject/
nb-configuration.xml

# --- Sistema operativo --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Logs y temporales --------------------------------------------------
*.log
logs/
*.pid
*.tmp
hs_err_pid*
replay_pid*

# --- Claude Code --------------------------------------------------------
# Se versiona .claude/settings.json (reglas del proyecto);
# los overrides locales de cada maquina, no.
.claude/settings.local.json
